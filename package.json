        },
        unit_amount: Math.round(deposit * 100)
      },
      quantity: 1
    }],
    success_url: ${process.env.BASE_URL}/success.html,
    cancel_url: ${process.env.BASE_URL}/booking.html
  });

  res.json({ success: true, url: session.url });
});

